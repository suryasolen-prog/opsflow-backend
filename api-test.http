# OpsFlow API smoke tests
# Replace the placeholder account values locally before running.
# Do not commit passwords, JWTs, or real environment-specific values.
@baseUrl = http://localhost:8080
@adminEmail = replace-with-existing-admin-email
@adminPassword = replace-with-admin-password
@developerEmail = replace-with-existing-developer-email
@developerPassword = replace-with-developer-password

### Health check (public)
GET {{baseUrl}}/actuator/health

### OpenAPI document (public)
GET {{baseUrl}}/v3/api-docs

### Log in as ADMIN
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
  client.global.set("adminToken", response.body.token);
%}

### ADMIN can access the admin-only endpoint (expect 200)
GET {{baseUrl}}/api/users/admin-test
Authorization: Bearer {{adminToken}}

### Log in as DEVELOPER
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{developerEmail}}",
  "password": "{{developerPassword}}"
}

> {%
  client.global.set("developerToken", response.body.token);
%}

### DEVELOPER cannot access the admin-only endpoint (expect 403)
GET {{baseUrl}}/api/users/admin-test
Authorization: Bearer {{developerToken}}

### Requests without a token must not access protected user data (expect 401)
GET {{baseUrl}}/api/users
